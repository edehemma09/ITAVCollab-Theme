{include file="partials/header.tpl" title="About ITAVCollab — It Takes A Village Collaborative" page_description="Learn about It Takes A Village Collaborative — founded by sisters Shearegned Phillpotts and Aishia Manley-Phillpotts to build healing, wellness, and community empowerment."}

      <!-- 1. ABOUT HERO -->
      <section class="about-hero" aria-label="About ITAVCollab">
        <img
          class="about-hero-bg"
          src="{weebly_cdn}assets/images/about-hero-group-photo.jpg"
          alt="Four women in colorful dresses standing outdoors representing the ITAVCollab community"
        />
        <div class="about-hero-overlay" aria-hidden="true"></div>
        <div class="about-hero-content">
          <h1 class="about-hero-title">About ITAVCollab</h1>
        </div>
      </section>

      <!-- 2. VISION STATEMENT -->
      <section class="vision-section" aria-label="Our Vision">
        <div class="vision-card">
          <p class="vision-text">
            We envision a world of thriving communities where
            <span class="vision-green">wellness is accessible,</span>
            <span class="vision-green">culturally affirming,</span>
            and <span class="vision-green">sustained across generations.</span>
          </p>
        </div>
      </section>

      <!-- 3. STORY — Founders -->
      <section id="mission" class="story-section" aria-label="Our Story — Founding">
        <div class="story-image-col">
          <img src="{weebly_cdn}assets/images/about-founder-portrait.jpg" alt="Portrait of an ITAVCollab co-founder" loading="lazy" />
        </div>
        <div class="story-text-col">
          <div class="story-text-inner">
            <p class="story-body">
              Founded in 2019, It Takes A Village Collaborative (ITAVCollab) was created by sisters
              <span class="story-green">Shearegned Phillpotts and Aishia Manley-Phillpotts,</span>
              whose Caribbean upbringing in Hyattsville, Maryland, instilled in them a deep commitment
              to kinship, community care, and shared responsibility.
            </p>
          </div>
        </div>
      </section>

      <!-- 4. STORY — The Movement -->
      <section class="story-section reverse" aria-label="Our Story — The Movement">
        <div class="story-image-col">
          <img src="{weebly_cdn}assets/images/about-sisters-movement.jpg" alt="Co-founder of ITAVCollab with vibrant artwork in the background" loading="lazy" />
        </div>
        <div class="story-text-col">
          <div class="story-text-inner">
            <p class="story-body">
              Raised with the belief that
              <span class="story-green">"it takes a village" is more than a proverb</span>—it
              is a practice—the sisters witnessed the challenges Black women face in navigating
              health and wellness systems that often fail to acknowledge their lived experiences.
              <span class="story-green">What began as a conversation between sisters quickly evolved into a movement.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- 5. STORY — Mission & Dialogue -->
      <section class="story-section" aria-label="Our Story — Mission">
        <div class="story-image-col">
          <img src="{weebly_cdn}assets/images/about-community-dialogue.jpg" alt="Community members gathered indoors for a dialogue circle session" loading="lazy" />
        </div>
        <div class="story-text-col">
          <div class="story-text-inner">
            <p class="story-body">
              Through dialogue circles and community-listening sessions, Shearegned and Aishia heard
              recurring stories of burnout, generational fatigue, and a lack of culturally relevant
              resources for healing and self-care.
              <br/><br/>
              These experiences helped shape ITAVCollab's mission:
              <span class="story-green">to close critical gaps in holistic wellness services</span>
              and ensure that community members—across generations—have
              <span class="story-green">access to the mental, emotional, and physical support they deserve.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- 6. STORY — Impact Today -->
      <section id="impact" class="story-section reverse" aria-label="Our Story — Impact Today">
        <div class="story-image-col">
          <img src="{weebly_cdn}assets/images/about-wellness-session.jpg" alt="Women participating in a wellness and healing session at ITAVCollab" loading="lazy" />
        </div>
        <div class="story-text-col">
          <div class="story-text-inner">
            <p class="story-body">
              Today, ITAVCollab serves as a trusted wellness hub for residents of Prince George's
              County, MD, and Washington, DC. We bring together practitioners, healers, educators,
              and community leaders to
              <span class="story-green">provide trauma-informed, culturally grounded offerings that center Black women and those justice-impacted.</span>
              <br/><br/>
              Our vision is bold yet deeply rooted: to build thriving historically resilient
              communities by nurturing
              <span class="story-green">wellness as a collective, intergenerational right and legacy.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- 7. FEATURE CARD — The ITAVCollab Team -->
      <section id="team" class="feature-card-section" aria-label="The ITAVCollab Team">
        <div class="feature-card-image">
          <img src="{weebly_cdn}assets/images/about-team-photo.jpg" alt="The ITAVCollab team members in colorful outfits" loading="lazy" />
        </div>
        <div class="feature-card-content">
          <h2 class="feature-card-title">The ITAVCollab Team</h2>
          <p class="feature-card-desc">
            Meet the team that's actively working to bring holistic wellness and healing to
            historically resilient communities.
          </p>
          <a href="{page_url:about}#team-members" class="btn btn-green">Meet the Team</a>
        </div>
      </section>

      <!-- 8. FEATURE CARD — Self-Care Beyond the Surface -->
      <section id="approach" class="feature-card-section" aria-label="Self-Care Beyond the Surface">
        <div class="feature-card-image">
          <img src="{weebly_cdn}assets/images/about-self-care-session.jpg" alt="Community members engaged in a self-care and wellness program" loading="lazy" />
        </div>
        <div class="feature-card-content">
          <h2 class="feature-card-title">Self-Care Beyond the Surface&#8482;</h2>
          <p class="feature-card-desc">
            Learn about our approach to solving systemic inequities in health care and wellness.
          </p>
          <a href="{page_url:about}#approach-detail" class="btn btn-green">Learn Our Approach</a>
        </div>
      </section>

      <!-- 9. FEATURE CARD — Bringing Wellness to the DMV -->
      <section class="feature-card-section" aria-label="Bringing Wellness to the DMV">
        <div class="feature-card-image">
          <img src="{weebly_cdn}assets/images/about-dmv-wellness.jpg" alt="Women in a bright wellness space in the DMV area" loading="lazy" />
        </div>
        <div class="feature-card-content">
          <h2 class="feature-card-title">Bringing Wellness to the DMV</h2>
          <p class="feature-card-desc">
            Discover how ITAVCollab has made an impact in Prince George's County and Washington, D.C.
          </p>
          <a href="{page_url:about}#impact" class="btn btn-green">Discover Our Impact</a>
        </div>
      </section>

{include file="partials/footer.tpl"}
